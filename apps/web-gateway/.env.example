# ==============================================================================
# KOPKARSAI Digital Gateway — Environment Configuration
# ==============================================================================
# Konfigurasikan URL tujuan untuk kedua layanan utama KOPKARSAI.
# Sistem akan memvalidasi bahwa URL harus diawali dengan http:// atau https://.
# Jika URL kosong atau belum valid, kartu layanan akan menampilkan status
# "Tautan belum dikonfigurasi" dan menonaktifkan navigasi secara aman.

# 1. URL Sistem Koperasi (contoh lokal: http://localhost:5173 atau produksi: https://koperasi.kopkarsai.com)
VITE_KOPKARSAI_SYSTEM_URL=

# 2. URL Marketplace Karyawan (contoh lokal: http://localhost:5174 atau produksi: https://marketplace.kopkarsai.com)
VITE_KOPKARSAI_MARKETPLACE_URL=
